# 复制为 .dev.vars 后填写。.dev.vars 已被 gitignore。
# 任何 OpenAI 兼容端点都可以（OpenCode Go / AI Gateway / OpenAI / DeepSeek ...）
MODEL_BASE_URL=https://opencode.ai/inference/go/openai/v1/chat/completions
MODEL_API_KEY=sk-xxx
MODEL_ID=deepseek-v4.1-flash

# 发布功能（Workers / D1 / 自定义域名）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=30b1fdd8911e31a3a0bce42e54cc1ed6
CLOUDFLARE_ZONE_ID=110909d14c2bd3bf532c1044ef64013b
CLOUDFLARE_WORKERS_SUBDOMAIN=fengyj-30b

# Token 用量与每日限额（可选）
# 每天全站美元上限，默认 1 美元；设为 0 表示不限制。
DAILY_COST_LIMIT_USD=1
# 预留给单轮透支的金额；剩余额度低于它时直接判定额度不足。默认 0.05。
DAILY_COST_RESERVE_USD=0.05
# 可选的 token 上限；0/留空表示不限制。
DAILY_TOKEN_LIMIT=
# 价格表覆盖；内置 opencode-go/deepseek-v4.1-flash 默认价格，未覆盖时用内置值。
# 格式：{"model-id":{"inputPerMillion":0.15,"outputPerMillion":0.6,"cacheReadPerMillion":0.003}}
MODEL_PRICING_JSON=
# 每日统计时区，默认 Asia/Shanghai
USAGE_TIMEZONE=Asia/Shanghai
# 上下文压缩阈值与保留最近 token；默认 100k / 20k。
COMPACTION_TOKEN_THRESHOLD=100000
COMPACTION_KEEP_RECENT_TOKENS=20000
