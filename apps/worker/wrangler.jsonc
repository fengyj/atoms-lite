{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atoms-lite",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  "containers": [
    {
      "class_name": "Workspace",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "ChatAgent", "name": "ChatAgent" },
      { "class_name": "Workspace", "name": "WORKSPACE" },
      { "class_name": "Projects", "name": "PROJECTS" }
    ]
  },
  "exports": {
    "ChatAgent": { "type": "durable-object", "storage": "sqlite" },
    "Workspace": { "type": "durable-object", "storage": "sqlite" },
    "Projects": { "type": "durable-object", "storage": "sqlite" }
  }
,
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "30b1fdd8911e31a3a0bce42e54cc1ed6",
    "CLOUDFLARE_ZONE_ID": "110909d14c2bd3bf532c1044ef64013b",
    "USAGE_TIMEZONE": "Asia/Shanghai",
    "DAILY_COST_LIMIT_USD": "1",
    "DAILY_COST_RESERVE_USD": "0.05",
    "COMPACTION_TOKEN_THRESHOLD": "100000",
    "COMPACTION_KEEP_RECENT_TOKENS": "20000"
  }
}
