{
  "name": "atoms-fullstack-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm build:worker",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "start": "node server/index.js",
    "build:worker": "rolldown server/worker.js -f esm -p neutral -o .atoms-lite/worker.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.19",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "rolldown": "1.2.19"
  },
  "packageManager": "pnpm@11.6.0"
}
