{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poc-10-sandbox-sdk",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "atoms-lite.fengyj.me", "custom_domain": true }
  ],
  "containers": [
    {
      "class_name": "Parent",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Parent", "name": "PARENT" },
      { "class_name": "Child", "name": "CHILD" }
    ]
  },
  "exports": {
    "Parent": { "type": "durable-object", "storage": "sqlite" },
    "Child": { "type": "durable-object", "storage": "sqlite" }
  }
}
