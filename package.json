{
  "name": "atoms-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* run dev",
    "dev:web": "pnpm --filter @atoms-lite/web dev",
    "dev:worker": "pnpm --filter @atoms-lite/worker dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "clean": "rm -rf apps/*/.next apps/*/.wrangler apps/*/dist node_modules/.cache"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
